# LLM provider: mock (default, offline, deterministic) | openai | groq | ollama
OMNIKNOW_PROVIDER=mock
OMNIKNOW_BASE_URL=https://api.openai.com/v1
OMNIKNOW_API_KEY=
OMNIKNOW_MODEL=gpt-4o-mini
OMNIKNOW_TIMEOUT=60

# Retrieval
OMNIKNOW_TOP_K=5
# Minimum fused evidence strength (0-1) before the agent answers instead of saying "I don't know"
OMNIKNOW_MIN_EVIDENCE=0.35
# Optional path to your own corpus directory (must contain manifest.json); defaults to the packaged sample corpus
OMNIKNOW_CORPUS_DIR=

# --- HTTP service (omniknow serve) ---
# Comma-separated API keys; when set every /api call needs X-API-Key or Authorization: Bearer
OMNIKNOW_API_KEYS=
# Dev mode: no auth, full access (localhost only). With no keys and no dev mode the service
# runs as a public demo (packaged sample corpus + mock provider only, responses marked simulated).
OMNIKNOW_DEV_MODE=false
OMNIKNOW_CORS_ORIGINS=
# General per-client limit, plus stricter limits for /api/ask and /api/evals (per minute)
OMNIKNOW_RATE_LIMIT_PER_MINUTE=120
OMNIKNOW_ASK_LIMIT_PER_MINUTE=20
OMNIKNOW_EVAL_LIMIT_PER_MINUTE=4
# Only enable behind a reverse proxy you control (uses the right-most X-Forwarded-For hop)
OMNIKNOW_TRUST_PROXY=false
# Host port published by docker compose (container still listens on 8000)
OMNIKNOW_HOST_PORT=8000
